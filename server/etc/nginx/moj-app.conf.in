# MOJ — corpo do vhost (estático + API + docs). Incluído pelos server blocks de PRODUÇÃO.
# TEMPLATE: gerado em /etc/nginx/snippets/moj-app.conf por `server/bin/install-nginx.sh`
# (substitui @WORKROOT@ e @ROUTER@). Não edite o gerado — edite este.
#
# @ROUTER@ = caminho do router.sh COMO O FCGIWRAP O ENXERGA:
#   - deploy podman (padrão): /opt/moj/cdmoj/server/api/v1/router.sh  (dentro da imagem!)
#   - bare-metal:             @WORKROOT@/cdmoj/server/api/v1/router.sh
# Apontar p/ o caminho do host num deploy em container = fcgiwrap não acha o script (502).

root   @WORKROOT@/cdmoj/web;
index  index.html;

# --- COMPRESSÃO ---------------------------------------------------------------------------
# O `gzip on` do nginx.conf sozinho comprime só text/html: o PLACAR (text/plain) e TODA a API
# (application/json) saíam CRUS. Num contest de 2000 times o placar é 168 KB por consulta, e
# cada time o pede a cada 30-60 s — 60 Mbit/s sustentados só nisso. Comprimido ele vai a 11 KB
# (14×, medido em 2026-08-20), e a conta cai p/ ~4 Mbit/s. É o que protege a sede de link magro.
# `gzip_proxied any` importa porque a resposta da API vem do fcgiwrap (upstream).
gzip              on;
gzip_vary         on;
gzip_proxied      any;
# nível 2, não 5: medido a 2026-08-20 num payload de 2,1 MB, o nível 5 custa ~1,8× a CPU do
# nível 2 e a razão de compressão de TEXTO muda pouco (o placar comprime 14× nos dois). Em
# resposta grande isso é a diferença entre 137 e 76 req/s.
gzip_comp_level   2;
gzip_min_length   1024;
gzip_types        text/plain text/css text/csv application/json application/javascript
                  text/javascript application/xml image/svg+xml;

# --- redirects de URLs do MOJ ANTIGO (links por aí em e-mails/favoritos/planilhas) --------
# /cgi-bin/index.sh era a home do CGI; /new/ era o prefixo da interface nova no site velho.
location = /cgi-bin/index.sh { return 301 /; }
location = /new  { return 301 /; }
location = /new/ { return 301 /; }
# problema legado: /new/treino/problem/?id=<org>.<slug> -> /treino/problema/?id=<org>%23<slug>
# (o map $moj_legacy_probid converte o 1º ponto em %23; id já canônico passa direto)
location /new/treino/problem/ {
    if ($moj_legacy_probid != "") { return 301 /treino/problema/?id=$moj_legacy_probid; }
    return 301 /treino/problema/?id=$arg_id;
}
# demais caminhos /new/<x> -> /<x> (a interface nova É a raiz agora)
location /new/ { rewrite ^/new/(.*)$ /$1 permanent; }
# Teto do CORPO da requisição. Quem manda no número é o `moj push`: ele serializa o pacote inteiro num
# JSON e os testes vão como STRING CRUA (não base64), então o corpo ≈ tamanho do pacote + ~10% de
# escape. Pacote de 500 MB ⇒ corpo de ~550 MB. (O `moj upload` manda tar.gz+base64 — 5-10× menor —, e
# para pacote gigante continua sendo o caminho mais barato.) Estourar isto é 413.
client_max_body_size  1000m;

# --- API: router.sh (bash) via fcgiwrap, num socket unix ---------------------------
# Os fastcgi_param vivem no NÍVEL DO SERVER (herdados) porque a API tem QUATRO locations — a
# geral e as três exceções do anteparo abaixo — e param duplicado é como elas divergem.
# ⚠ herança do nginx: uma location que declare QUALQUER fastcgi_param próprio perde TODOS os
# herdados — exceção nova não pode declarar param nenhum.
fastcgi_param  SCRIPT_FILENAME   @ROUTER@;
fastcgi_param  PATH_INFO         $fastcgi_path_info;
fastcgi_param  REQUEST_METHOD    $request_method;
fastcgi_param  QUERY_STRING      $query_string;
fastcgi_param  CONTENT_TYPE      $content_type;
fastcgi_param  CONTENT_LENGTH    $content_length;
fastcgi_param  HTTP_AUTHORIZATION $http_authorization;
fastcgi_param  HTTP_USER_AGENT    $http_user_agent;
# Sem esta linha o atalho do placar PRÉ-COMPRIMIDO nunca dispara (score.sh/problems.sh leem
# HTTP_ACCEPT_ENCODING p/ servir o .gz pronto): confirmado em produção 28/08/2026 — resposta
# chunked = o nginx recomprimia o MESMO corpo a cada requisição (~7% da vazão da rota).
fastcgi_param  HTTP_ACCEPT_ENCODING $http_accept_encoding;
fastcgi_param  HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
fastcgi_param  HTTP_X_REAL_IP     $http_x_real_ip;
fastcgi_param  REMOTE_ADDR       $remote_addr;
fastcgi_param  SERVER_PROTOCOL   $server_protocol;
fastcgi_param  GATEWAY_INTERFACE CGI/1.1;
# Contest isolado quando o acesso vem por <id>.<host> — o $moj_contest_host vem do `map`
# do conf.d/moj.conf e é VAZIO no site principal (o router.sh trata vazio como ausente).
fastcgi_param  CONTEST_HOST      $moj_contest_host;
# Rede de segurança, NÃO o conserto: um POST grande (pacote de problema) tem de terminar em
# segundos (o handler não re-parseia mais o corpo N vezes). Se o nginx desiste, o processo do
# handler NÃO morre junto — ele segue gravando, e o cliente fica sem saber se aplicou. Por isso
# a folga: preferimos a resposta certa a um 504 com efeito indeterminado.
fastcgi_read_timeout 300s;

# ANTEPARO DE CONCORRÊNCIA (2026-08-27, véspera da Maratona): o pool do fcgiwrap (64 workers) é
# compartilhado por TODO o tráfego, e o nginx não tem fila com prioridade — o que ele sabe fazer
# é impedir que uma classe ocupe o pool inteiro. A classe vem DE GRAÇA do host: contest =
# subdomínio, treino/site = host principal ($moj_site_conn, do conf.d/moj.conf; chave VAZIA =
# limite não se aplica, então o subdomínio passa livre). Excedente do site leva **429** na hora
# (decisão do Ribas: a web do treino degrada sem quebrar) em vez de enfileirar no socket.
#
# EXCEÇÕES (locations mais específicas, SEM limite — o prefixo mais longo vence): o que entra
# pelo host principal mas é VITAL para a prova:
#   /api/v1/judge/     o heartbeat dos juízes — o PULSO do julgamento (vem pela LAN, host principal)
#   /api/v1/ops/       o bot dos alertas — é na crise que ele mais importa
#   /api/v1/problems/  autoria de problemas — gente terminando exercício QUE PODE ESTAR NA PROVA
#
# FREIO DE EMERGÊNCIA: `touch /etc/nginx/moj-shed-treino` derruba a API do host principal (503)
# na hora, sem reload; `rm` religa. Por classe ($moj_shed_file): o subdomínio de contest e as
# três exceções nunca olham o arquivo.
#
# QUEBRA-CIRCUITO do CONTEST (2026-08-28): o include por GLOB abaixo carrega
# /etc/nginx/moj-breaker-contest.conf (`limit_conn moj_contest 40;`) quando ele EXISTE — ausente,
# o glob casa nada e o contest fica sem limite (era o comportamento até hoje). O excedente leva 429
# rápido em vez de estacionar 25 s na fila do socket até o colapso (medido 27/08); os polls da web
# tentam de novo sozinhos (o placar e a fila do juiz também, desde 05/11/2026). Vale TAMBÉM para
# /submit, de propósito: a fila profunda é pior que o 429 (o aluno reenviaria contra um servidor já
# afogado). O NÚMERO: nasceu 56 (28/08), caiu p/ 32 na crise da Maratona (29/08, router.sh a 25
# núcleos nos polls de summary/history) e subiu p/ 40 em 05/11/2026 — summary no porteiro e mídia de
# time servida do disco: o contest (40) + o site (16) = 56 do pool de 64, e sobram ~8 p/ as exceções
# sem limite (heartbeat dos juízes, /ops, /problems) e CPU p/ o judged. Mexer: editar o arquivo +
# reload (é config do host, decisão do operador). DESLIGAR: rm do arquivo + reload.
# MICROCACHE POR-TOKEN (include por glob, mesmo padrão do breaker): entrada por Authorization,
# GET+200, TTL 2s — F5 repetido vira hit sem forkar bash; webcast excluído por map (tempo exato).
# As três exceções abaixo NÃO têm o include: judge/ops/problems nunca são cacheados.
location /api/v1/ {
    limit_conn moj_site 16;
    include /etc/nginx/moj-breaker-contest[.]conf;
    include /etc/nginx/moj-cache-api[.]conf;
    if (-f $moj_shed_file) { return 503; }
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
# --- MOLDE (workers bash persistentes) ----------------------------------------------------
# Rotas migradas p/ o molde entram como snippets em /etc/nginx/moj-molde-routes/*.conf
# (um por rota, gerados por server/bin/molde-route.sh add|rm <rota> — rollback por rota é
# `molde-route.sh rm` ou o rm do arquivo + reload). Cada snippet replica anteparo/breaker/
# microcache/shed e aponta p/ o socket do molde com `error_page 502 = @moj_fcgiwrap`:
# shim morto/afogado ⇒ o nginx repete a requisição no fcgiwrap clássico SOZINHO.
# ⚠ Fallback é SÓ no 502 (conexão/resposta inválida) — nunca no 504: requisição lenta
# repetida no outro pool dobraria a carga exatamente na hora errada.
include /etc/nginx/moj-molde-routes/*[.]conf;
# ⚠ O fallback TAMBÉM respeita o quebra-circuito de contest (include por glob, some com o
# rm do arquivo): sem isso, cada decline do porteiro vira um bash SEM teto que segura a
# conexão na zona moj_porteiro pelos segundos inteiros do bash — a zona enche e passa a
# 429ar até as respostas de 2 ms (colapso medido no teste de 28/08: score declinando sob
# veredicto contínuo derrubou o caminho rápido inteiro). Com o teto, o excesso de fallback
# leva 429 na hora e o caminho rápido continua aberto.
location @moj_fcgiwrap {
    include                 /etc/nginx/moj-breaker-contest[.]conf;
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}

location /api/v1/judge/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
location /api/v1/ops/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
location /api/v1/problems/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}

# --- MÍDIA DE TIME (05/11/2026) ----------------------------------------------------------
# Maps e zona no conf.d/moj.conf (bloco "MÍDIA DE TIME"). Mídia de time é PÚBLICA por desenho (vai ao telão externo,
# que busca sem sessão — ver os handlers contest/{team-logo,team-photo,team-music,placeholder}.sh), então o nginx serve o
# BRASÃO, a FOTO, a MÚSICA e o PADRÃO direto do disco: zero bash, fora de todo balde, ETag/Last-Modified de graça (304)
# e Range (206) no áudio. O bash continua sendo a autoridade: argumento fora da lista de caracteres, host de OUTRO
# contest, contest que não existe, a miniatura que ainda não existe (o bash a gera) e o brasão ausente caem nele
# (@moj_media).
# ⚠ A miniatura do disco é servida SEM o `-nt` do tp_thumb: quem garante que ela é da foto atual é quem grava
# (tp_store a apaga e troca a foto sob o flock dela; tp_remove a apaga primeiro; photos-to-webp.sh idem).
# ⚠ O padrão de fábrica sai do CHECKOUT (cdmoj/server/etc/team-placeholder.*), o bash o lê da IMAGEM: são o mesmo
# arquivo enquanto a imagem e o checkout estiverem no mesmo commit (o deploy de sempre).
# ⚠ A TRAVA DE SEDE (lib/site-lock.sh) NÃO se repete aqui: run/site-lock é 700 de propósito (o nginx não o enxerga), e
# o que ela protege é o conteúdo de outro contest/treino durante a prova — mídia pública de time não é isso. Um IP
# preso baixa a mídia de outro contest pelo site principal; todo o resto segue barrado pelo bash.
# ⚠ add_header numa location ANULA o do pai (regra do nginx): o server não declara nenhum, nada se perde.
location = /api/v1/contest/team-logo {
    root          @WORKROOT@/contests;
    default_type  image/png;
    try_files     $moj_logo_file @moj_media;
    add_header    Cache-Control $moj_logo_cc;
}
location = /api/v1/contest/team-photo {
    root          @WORKROOT@/contests;
    try_files     $moj_photo_file $moj_photo_alt @moj_padrao;
    add_header    Cache-Control $moj_photo_cc;
}
location = /api/v1/contest/team-music {
    root          @WORKROOT@/contests;
    try_files     $moj_music_file @moj_padrao;
    add_header    Cache-Control $moj_music_cc;
}
# a rota do padrão entra direto no @moj_padrao (o try_files num arquivo que nunca existe é o "vá p/ lá": um error_page
# aqui faria o 418 do @moj_padrao virar error_page recursivo, que o nginx não segue)
location = /api/v1/contest/placeholder {
    try_files     /.sem-midia @moj_padrao;
}
# O PADRÃO (time sem foto/música e a rota /contest/placeholder): o do contest, senão o de fábrica, como o
# tp_placeholder/tm_placeholder. Sem user válido (team-*), contest inexistente, `kind` que só o bash entende ou a foto do
# time no disco (é a miniatura que falta: o bash a gera) = o bash.
location @moj_padrao {
    root          @WORKROOT@;
    error_page    418 = @moj_media;
    if (!-f $moj_ph_conf) { return 418; }
    if (-f $moj_ph_has_webp) { return 418; }
    if (-f $moj_ph_has_png) { return 418; }
    try_files     $moj_ph1 $moj_ph2 $moj_ph3 $moj_ph4 @moj_media;
    add_header    Cache-Control "public, max-age=60";
    add_header    X-MOJ-Photo $moj_ph_photo_hdr;
    add_header    X-MOJ-Music $moj_ph_music_hdr;
}
# O que cai no bash vai a uma zona PRÓPRIA de 16 em voo: com o site (16) e o contest (32, o breaker) fecha o pool de 64
# do fcgiwrap — mídia não disputa o balde do /submit. Excedente = 429. Microcache e freio do treino como na /api/v1/
# geral; o breaker do contest NÃO (é o balde que a mídia deixou).
location @moj_media {
    limit_conn              moj_media 16;
    include                 /etc/nginx/moj-cache-api[.]conf;
    if (-f $moj_shed_file) { return 503; }
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}

# --- documentação (markdown cru) ---------------------------------------------------
# docs RENDERIZADAS (docs/html/ = artefato do build-html.sh, com index/nav/css) — o alias
# antigo p/ docs/ cru servia .md com autoindex e 404 em /docs/API.html. autoindex fica como
# fallback p/ checkout sem build. /docs sem barra redireciona (dava 404 seco).
location = /docs { return 301 /docs/; }
location /docs/ { alias @WORKROOT@/cdmoj/docs/html/; autoindex on; }

# --- relatórios PUBLICADOS (histórico dos eventos) ---------------------------------
# contests/<id>/relatorio/ = site estático do report-gen que o admin publicou (Operação ›
# Situação › Publicar relatório; POST /contest/admin/report-publish). Só existe quando
# publicado — o alias serve direto (o worker do nginx está no grupo do dono do workspace;
# os arquivos nascem 660/770 do container). O /index/contests aponta p/ cá (report_url).
# Rodadas ARQUIVADAS publicadas: relatorio-rodadas/<slug> é um SYMLINK p/ rounds/<slug>/relatorio
# criado pelo publish-round (sem symlink = 404). Regex ANTES do genérico (nginx pega o 1º que casa).
location ~ ^/relatorio/([a-z0-9][a-z0-9._-]*)/rodada/([a-z0-9][a-z0-9_-]*)$ { return 301 $uri/; }
location ~ ^/relatorio/([a-z0-9][a-z0-9._-]*)/rodada/([a-z0-9][a-z0-9_-]*)/(.*)$ {
    alias @WORKROOT@/contests/$1/relatorio-rodadas/$2/$3;
    index index.html;
}
location ~ ^/relatorio/([a-z0-9][a-z0-9._-]*)$ { return 301 $uri/; }
location ~ ^/relatorio/([a-z0-9][a-z0-9._-]*)/(.*)$ {
    alias @WORKROOT@/contests/$1/relatorio/$2;
    index index.html;
}

# --- frontend estático (ESM, sem build) --------------------------------------------
# no-cache = REVALIDA a cada uso (ETag/Last-Modified do nginx; 304 quando nada mudou). Sem
# isto o navegador guardava os módulos pela heurística e um deploy deixava JS VELHO falando
# com TXT NOVO: no evento de 29-30/08 o placar passou a células em segundos (`icpc s`) e o
# score-icpc.js em cache mostrou "1/17029" como minutos (issue #22). Só aqui: /docs/ e
# /relatorio/ têm location própria e a API já é dinâmica.
# ROBÔS (30/10/2026): o web/ é o MESMO em todo host, então o /robots.txt sai por host — no subdomínio de contest
# ($moj_contest_host não vazio) é o web/robots-contest.txt ("Disallow: /": prova efêmera, site repetido em cada
# subdomínio; eram ~84% dos pedidos de robô); no site principal, o web/robots.txt (só a API fica de fora).
location = /robots.txt {
    if ($moj_contest_host != "") { rewrite ^ /robots-contest.txt last; }
    add_header Cache-Control "public, max-age=3600";
}
location / { try_files $uri $uri/ =404; add_header Cache-Control "no-cache, must-revalidate"; }
# IMAGENS que mudam pouco (TCP 2026, 03/10/2026): o no-cache acima vale p/ o JS/CSS/HTML (issue #22), mas fazia cada
# imagem REVALIDAR a cada uso — numa rede com perda de pacote (as sedes do Chile) cada ida e volta custa, e o placar
# pede uma bandeira por linha. Estas guardam por 7 dias: as telas dos tutoriais, as bandeiras (só os SVGs de
# country/ e br/ — o index.json fica revalidando) e os ícones do site. Imagem velha por uns dias é inofensiva; JS
# velho não, e por isso NADA de JS aqui. `^~`: prefixo que encerra a busca — uma regex (`~* \.png$`) passaria na
# frente das locations do /relatorio/ (alias) e serviria a imagem errada. Sem add_header no nível do server, o desta
# location não derruba nenhum outro cabeçalho (a regra do nginx: add_header de location ANULA o do pai).
location ^~ /contest/ajuda/img/   { try_files $uri =404; add_header Cache-Control "public, max-age=604800"; }
location ^~ /shared/flags/country/ { try_files $uri =404; add_header Cache-Control "public, max-age=604800"; }
location ^~ /shared/flags/br/     { try_files $uri =404; add_header Cache-Control "public, max-age=604800"; }
location ^~ /shared/assets/       { try_files $uri =404; add_header Cache-Control "public, max-age=604800"; }
