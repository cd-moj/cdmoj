# MOJ — corpo do vhost (estático + API + docs). Incluído pelos server blocks de PRODUÇÃO.
# TEMPLATE: gerado em /etc/nginx/snippets/moj-app.conf por `server/bin/install-nginx.sh`
# (substitui @WORKROOT@ e @ROUTER@). Não edite o gerado — edite este.
#
# @ROUTER@ = caminho do router.sh COMO O FCGIWRAP O ENXERGA:
#   - deploy podman (padrão): /opt/moj/cdmoj/server/api/v1/router.sh  (dentro da imagem!)
#   - bare-metal:             @WORKROOT@/cdmoj/server/api/v1/router.sh
# Apontar p/ o caminho do host num deploy em container = fcgiwrap não acha o script (502).

root   @WORKROOT@/cdmoj/web;
index  index.html;

# --- COMPRESSÃO ---------------------------------------------------------------------------
# O `gzip on` do nginx.conf sozinho comprime só text/html: o PLACAR (text/plain) e TODA a API
# (application/json) saíam CRUS. Num contest de 2000 times o placar é 168 KB por consulta, e
# cada time o pede a cada 30-60 s — 60 Mbit/s sustentados só nisso. Comprimido ele vai a 11 KB
# (14×, medido em 2026-08-20), e a conta cai p/ ~4 Mbit/s. É o que protege a sede de link magro.
# `gzip_proxied any` importa porque a resposta da API vem do fcgiwrap (upstream).
gzip              on;
gzip_vary         on;
gzip_proxied      any;
# nível 2, não 5: medido a 2026-08-20 num payload de 2,1 MB, o nível 5 custa ~1,8× a CPU do
# nível 2 e a razão de compressão de TEXTO muda pouco (o placar comprime 14× nos dois). Em
# resposta grande isso é a diferença entre 137 e 76 req/s.
gzip_comp_level   2;
gzip_min_length   1024;
gzip_types        text/plain text/css text/csv application/json application/javascript
                  text/javascript application/xml image/svg+xml;

# --- redirects de URLs do MOJ ANTIGO (links por aí em e-mails/favoritos/planilhas) --------
# /cgi-bin/index.sh era a home do CGI; /new/ era o prefixo da interface nova no site velho.
location = /cgi-bin/index.sh { return 301 /; }
location = /new  { return 301 /; }
location = /new/ { return 301 /; }
# problema legado: /new/treino/problem/?id=<org>.<slug> -> /treino/problema/?id=<org>%23<slug>
# (o map $moj_legacy_probid converte o 1º ponto em %23; id já canônico passa direto)
location /new/treino/problem/ {
    if ($moj_legacy_probid != "") { return 301 /treino/problema/?id=$moj_legacy_probid; }
    return 301 /treino/problema/?id=$arg_id;
}
# demais caminhos /new/<x> -> /<x> (a interface nova É a raiz agora)
location /new/ { rewrite ^/new/(.*)$ /$1 permanent; }
# Teto do CORPO da requisição. Quem manda no número é o `moj push`: ele serializa o pacote inteiro num
# JSON e os testes vão como STRING CRUA (não base64), então o corpo ≈ tamanho do pacote + ~10% de
# escape. Pacote de 500 MB ⇒ corpo de ~550 MB. (O `moj upload` manda tar.gz+base64 — 5-10× menor —, e
# para pacote gigante continua sendo o caminho mais barato.) Estourar isto é 413.
client_max_body_size  1000m;

# --- API: router.sh (bash) via fcgiwrap, num socket unix ---------------------------
# Os fastcgi_param vivem no NÍVEL DO SERVER (herdados) porque a API tem QUATRO locations — a
# geral e as três exceções do anteparo abaixo — e param duplicado é como elas divergem.
# ⚠ herança do nginx: uma location que declare QUALQUER fastcgi_param próprio perde TODOS os
# herdados — exceção nova não pode declarar param nenhum.
fastcgi_param  SCRIPT_FILENAME   @ROUTER@;
fastcgi_param  PATH_INFO         $fastcgi_path_info;
fastcgi_param  REQUEST_METHOD    $request_method;
fastcgi_param  QUERY_STRING      $query_string;
fastcgi_param  CONTENT_TYPE      $content_type;
fastcgi_param  CONTENT_LENGTH    $content_length;
fastcgi_param  HTTP_AUTHORIZATION $http_authorization;
fastcgi_param  HTTP_USER_AGENT    $http_user_agent;
fastcgi_param  HTTP_X_FORWARDED_FOR $http_x_forwarded_for;
fastcgi_param  HTTP_X_REAL_IP     $http_x_real_ip;
fastcgi_param  REMOTE_ADDR       $remote_addr;
fastcgi_param  SERVER_PROTOCOL   $server_protocol;
fastcgi_param  GATEWAY_INTERFACE CGI/1.1;
# Contest isolado quando o acesso vem por <id>.<host> — o $moj_contest_host vem do `map`
# do conf.d/moj.conf e é VAZIO no site principal (o router.sh trata vazio como ausente).
fastcgi_param  CONTEST_HOST      $moj_contest_host;
# Rede de segurança, NÃO o conserto: um POST grande (pacote de problema) tem de terminar em
# segundos (o handler não re-parseia mais o corpo N vezes). Se o nginx desiste, o processo do
# handler NÃO morre junto — ele segue gravando, e o cliente fica sem saber se aplicou. Por isso
# a folga: preferimos a resposta certa a um 504 com efeito indeterminado.
fastcgi_read_timeout 300s;

# ANTEPARO DE CONCORRÊNCIA (2026-08-27, véspera da Maratona): o pool do fcgiwrap (64 workers) é
# compartilhado por TODO o tráfego, e o nginx não tem fila com prioridade — o que ele sabe fazer
# é impedir que uma classe ocupe o pool inteiro. A classe vem DE GRAÇA do host: contest =
# subdomínio, treino/site = host principal ($moj_site_conn, do conf.d/moj.conf; chave VAZIA =
# limite não se aplica, então o subdomínio passa livre). Excedente do site leva **429** na hora
# (decisão do Ribas: a web do treino degrada sem quebrar) em vez de enfileirar no socket.
#
# EXCEÇÕES (locations mais específicas, SEM limite — o prefixo mais longo vence): o que entra
# pelo host principal mas é VITAL para a prova:
#   /api/v1/judge/     o heartbeat dos juízes — o PULSO do julgamento (vem pela LAN, host principal)
#   /api/v1/ops/       o bot dos alertas — é na crise que ele mais importa
#   /api/v1/problems/  autoria de problemas — gente terminando exercício QUE PODE ESTAR NA PROVA
#
# FREIO DE EMERGÊNCIA: `touch /etc/nginx/moj-shed-treino` derruba a API do host principal (503)
# na hora, sem reload; `rm` religa. Por classe ($moj_shed_file): o subdomínio de contest e as
# três exceções nunca olham o arquivo.
#
# QUEBRA-CIRCUITO do CONTEST (2026-08-28): o include por GLOB abaixo carrega
# /etc/nginx/moj-breaker-contest.conf (`limit_conn moj_contest 56;`) quando ele EXISTE — ausente,
# o glob casa nada e o contest fica sem limite (era o comportamento até hoje). 56 de 64: o
# excedente leva 429 rápido em vez de estacionar 25 s na fila do socket até o colapso (medido
# 27/08); os polls da web só tentam de novo no tick seguinte. Vale TAMBÉM para /submit, de
# propósito: com 56 em voo a fila profunda é pior que o 429 (o aluno reenviaria contra um
# servidor já afogado). DESLIGAR: rm do arquivo + reload (receita no moj-prod.conf.in).
location /api/v1/ {
    limit_conn moj_site 16;
    include /etc/nginx/moj-breaker-contest[.]conf;
    if (-f $moj_shed_file) { return 503; }
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
location /api/v1/judge/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
location /api/v1/ops/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}
location /api/v1/problems/ {
    fastcgi_pass            unix:@WORKROOT@/run/fcgiwrap.sock;
    fastcgi_split_path_info ^(/api/v1)(/.*)$;
}

# --- documentação (markdown cru) ---------------------------------------------------
# docs RENDERIZADAS (docs/html/ = artefato do build-html.sh, com index/nav/css) — o alias
# antigo p/ docs/ cru servia .md com autoindex e 404 em /docs/API.html. autoindex fica como
# fallback p/ checkout sem build. /docs sem barra redireciona (dava 404 seco).
location = /docs { return 301 /docs/; }
location /docs/ { alias @WORKROOT@/cdmoj/docs/html/; autoindex on; }

# --- frontend estático (ESM, sem build) --------------------------------------------
location / { try_files $uri $uri/ =404; }
