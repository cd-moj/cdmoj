# MOJ — vhost de PRODUÇÃO (nginx do SISTEMA, root, 80/443, com TLS).
# TEMPLATE: gerado em /etc/nginx/conf.d/moj.conf por `server/bin/install-nginx.sh --cert <nome>`.
# Sem certificado ainda? o installer usa o moj-prod-http.conf.in (HTTP-only) — ver DEPLOY.md.
# O modelo DEV (nginx user-space, como o próprio usuário, em 8080/8443) é outro:
# moj-subdomains.conf + ~/nginx-proxy/. Não misture os dois.
#
# UM server block serve o site principal E os subdomínios de contest: o `map` abaixo extrai o
# <id> de <id>.<host> e o passa em CONTEST_HOST (vazio no site principal). O router.sh impõe
# o isolamento — o nginx só transporta o id.
#
# PERMISSÕES (a pegadinha que dá 502): os workers do nginx (@NGINX_USER@) precisam
#   (a) atravessar @WORKROOT@ e ler cdmoj/web  → `usermod -aG @OWNER@ @NGINX_USER@`;
#   (b) conectar no socket unix do fcgiwrap, que nasce 0770 do dono (umask 007 no entrypoint).
# O install-nginx.sh cuida de (a); (b) vem de deploy/moj-entrypoint. Ver docs/DEPLOY.md.

map $host $moj_contest_host {
    default  "";
    @SUBDOMAIN_MAP@
}

# TEMPO DE RESPOSTA no log. Sem isto não se audita latência DEPOIS do fato: a auditoria de
# 24/08/2026 teve de medir ao vivo a rota lenta (`/index/status`, 7 s a frio) porque o log não
# guardava tempo nenhum — com o pico do dia já passado, não havia como saber o que a sala sentiu.
# `$request_time` é o total visto pelo cliente; `$upstream_response_time` é o que o fcgiwrap
# levou. A diferença entre os dois separa "a API está lenta" de "a rede/o corpo é grande".
# ⚠ Os dois campos vão no FIM: as 9 primeiras colunas continuam as do formato combined, então
# todo comando de análise que já existe (e os logs velhos) seguem valendo.
log_format moj '$remote_addr - $remote_user [$time_local] "$request" '
               '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
               'rt=$request_time urt=$upstream_response_time';

# ANTEPARO DE CONCORRÊNCIA do host principal (ver o comentário grande no moj-app.conf):
# classe pela MESMA divisão do $moj_contest_host — chave VAZIA = o limit_conn não se aplica,
# então o subdomínio de contest passa livre sem segundo bloco. Excedente = 429.
# Em HTTP/2 cada requisição concorrente conta como uma conexão (é o que queremos: o limite é
# de REQUISIÇÕES em voo, não de sockets).
map $moj_contest_host $moj_site_conn { "" "site"; default ""; }
limit_conn_zone $moj_site_conn zone=moj_site:1m;
limit_conn_status 429;
# freio de emergência POR CLASSE: só o host principal olha o arquivo; contest nunca.
map $moj_contest_host $moj_shed_file { "" "/etc/nginx/moj-shed-treino"; default "/nonexistent"; }

# QUEBRA-CIRCUITO do CONTEST (2026-08-28): a outra metade do anteparo. Um balde só para TODOS
# os subdomínios (o pool de 64 workers é um só; teto por-contest deixaria 2 contests somarem
# mais que o pool). Motivo medido no teste de 1.000 req/s de 27/08: acima do teto (~430 req/s)
# a fila do socket cresce além de capacidade×timeout e o goodput colapsa a ~zero (502 em massa),
# enquanto o host principal — capado a 16 — seguiu com p50 de 0,12 s sob 3,5× de sobrecarga.
# O TETO NÃO MORA AQUI: mora em /etc/nginx/moj-breaker-contest.conf (limit_conn moj_contest 56),
# incluído POR GLOB no snippet — arquivo ausente = SEM limite, sem erro de config. Desligar:
#   rm /etc/nginx/moj-breaker-contest.conf && systemctl reload nginx
# Religar: recriar o arquivo (o install-nginx.sh o recria se ausente) + reload.
map $moj_contest_host $moj_contest_conn { "" ""; default "contest"; }
limit_conn_zone $moj_contest_conn zone=moj_contest:1m;

# id de problema LEGADO (pontilhado, "org.slug") -> canônico URL-encoded ("org%23slug").
# Usado pelo redirect de /new/treino/problem/ (moj-app.conf.in). Só o PRIMEIRO ponto vira
# %23 (o slug pode ter pontos); %23 = '#' — literal no return viraria fragment.
map $arg_id $moj_legacy_probid {
    default "";
    "~^(?<lorg>[^.]+)\.(?<lslug>.+)$" "$lorg%23$lslug";
}

# --- :80 — desafio ACME (http-01) + redirect p/ HTTPS ------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name @SERVER_NAMES@ @SERVER_NAMES_RE@;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

# --- :443 — o MOJ ------------------------------------------------------------------
# A diretiva `http2 on;` só existe no nginx >= 1.25.1 (o Ubuntu 24.04 traz o 1.24, que só entende
# `listen … ssl http2`). O install-nginx.sh detecta a versão e escreve a forma certa aqui embaixo —
# usar a errada é [emerg] "unknown directive" e o nginx não recarrega.
server {
    listen      443 ssl@HTTP2_LISTEN@;
    listen      [::]:443 ssl@HTTP2_LISTEN@;
@HTTP2_ON@
    server_name @SERVER_NAMES@ @SERVER_NAMES_RE@;

    ssl_certificate     /etc/letsencrypt/live/@CERTNAME@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@CERTNAME@/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:MOJSSL:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/moj.access.log moj;
    error_log  /var/log/nginx/moj.error.log warn;

    include @SNIPPET@;
}
