# MOJ — vhost de PRODUÇÃO **sem TLS** (bootstrap: nginx no ar ANTES de existir certificado,
# e para o desafio http-01 do certbot, se você não usar DNS-01).
# TEMPLATE: gerado em /etc/nginx/conf.d/moj.conf por `server/bin/install-nginx.sh` SEM --cert.
# Depois de emitir o cert (server/bin/cert-setup.sh), rode o installer de novo COM --cert:
# ele troca este bloco pelo moj-prod.conf.in (TLS + redirect 80→443).

map $host $moj_contest_host {
    default  "";
    @SUBDOMAIN_MAP@
}

# id de problema LEGADO (pontilhado) -> canônico URL-encoded (ver moj-prod.conf.in)
map $arg_id $moj_legacy_probid {
    default "";
    "~^(?<lorg>[^.]+)\.(?<lslug>.+)$" "$lorg%23$lslug";
}

# tempo de resposta no log — MESMO formato do moj-prod.conf.in (só um dos dois é instalado)
log_format moj '$remote_addr - $remote_user [$time_local] "$request" '
               '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
               'rt=$request_time urt=$upstream_response_time host=$host sni=$ssl_server_name a=$moj_authd';
# host=/sni=/a= (16/10/2026, antes de fechar o IP cru — moj-unknown-host.conf.in): por qual NOME o pedido chegou, o
# nome do TLS (vazio = sem SNI, o IP cru) e se trazia token (1/0 — nunca o token). Também no fim: as colunas de
# antes não se mexem.
map $http_authorization $moj_authd { "" 0; default 1; }

# anteparo de concorrência — MESMOS mapas do moj-prod.conf.in (o snippet os referencia)
map $moj_contest_host $moj_site_conn { "" "site"; default ""; }
limit_conn_zone $moj_site_conn zone=moj_site:1m;
limit_conn_status 429;
map $moj_contest_host $moj_shed_file { "" "/etc/nginx/moj-shed-treino"; default "/nonexistent"; }
map $moj_contest_host $moj_contest_conn { "" ""; default "contest"; }
limit_conn_zone $moj_contest_conn zone=moj_contest:1m;
# zona PRÓPRIA das rotas do porteiro (28/08, teste de carga): requisição de ~1 ms não pode
# disputar slot com a de 200 ms do bash — na zona única, o bash lento enchia os 56 e o 429
# cortava também o que custava nada. 256 slots ociosos na prática; o transbordo do porteiro
# já tem fallback próprio (backlog 16 → 502 → @moj_fcgiwrap).
limit_conn_zone $moj_contest_conn zone=moj_porteiro:1m;

# >>> MÍDIA DE TIME (bloco IGUAL no moj-prod-http.conf.in; o smoke-team-logo-nginx.sh o lê daqui e compara os dois)
# 05/11/2026: no placar de 500+ times o brasão era rebaixado a cada minuto (max-age=60, sem validador) e cada pedido era
# um bash no balde do contest, o MESMO do /submit. As peças moram no snippet (moj-app.conf.in, "MÍDIA DE TIME"):
#   · o BRASÃO sai do disco pelo nginx. $moj_logo_file é o caminho RELATIVO a @WORKROOT@/contests SÓ quando os dois
#     argumentos passam na lista de caracteres ($arg_* chega CRU: sem %, sem /, sem ponto ou hífen no começo) e o host
#     é o site principal ou o subdomínio DO MESMO contest (o contest_mismatch do router.sh). Senão vira um caminho que
#     não existe e o pedido cai no bash, que segue sendo a autoridade (os 400/403/404 de sempre);
#   · com `v` na URL (o logo_v do /contest/teams, o mtime) a resposta é imutável; sem ele, 10 min + ETag (304 barato);
#   · zona PRÓPRIA p/ o bash de mídia (foto, música, padrão e o brasão que caiu no bash): não disputa o balde do contest.
map "$arg_contest|$moj_contest_host|$arg_user" $moj_logo_file {
    default "/.sem-brasao";
    "~^(?<mlc>[A-Za-z0-9][A-Za-z0-9._-]*)\|(?:\k<mlc>)?\|(?<mlu>[A-Za-z0-9][A-Za-z0-9._-]*)$" "/$mlc/users/$mlu/logo.png";
}
map $arg_v $moj_logo_cc { "" "public, max-age=600"; default "public, max-age=31536000, immutable"; }
map $host $moj_media_conn { default "media"; }
limit_conn_zone $moj_media_conn zone=moj_media:1m;
# <<< MÍDIA DE TIME
fastcgi_cache_path /run/moj-nginx-cache levels=1:2 keys_zone=moj_api:16m max_size=512m inactive=10s;
map $uri $moj_api_skip_uri { default 0; "~^/api/v1/contest/webcast" 1; }
map "$request_method$moj_api_skip_uri" $moj_api_skip { default 1; "GET0" 0; }

server {
    listen      80;
    listen      [::]:80;
    server_name @SERVER_NAMES@ @SERVER_NAMES_RE@;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    access_log /var/log/nginx/moj.access.log moj;
    error_log  /var/log/nginx/moj.error.log warn;

    include @SNIPPET@;
}
