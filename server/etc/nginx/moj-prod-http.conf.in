# MOJ — vhost de PRODUÇÃO **sem TLS** (bootstrap: nginx no ar ANTES de existir certificado,
# e para o desafio http-01 do certbot, se você não usar DNS-01).
# TEMPLATE: gerado em /etc/nginx/conf.d/moj.conf por `server/bin/install-nginx.sh` SEM --cert.
# Depois de emitir o cert (server/bin/cert-setup.sh), rode o installer de novo COM --cert:
# ele troca este bloco pelo moj-prod.conf.in (TLS + redirect 80→443).

map $host $moj_contest_host {
    default  "";
    @SUBDOMAIN_MAP@
}

# id de problema LEGADO (pontilhado) -> canônico URL-encoded (ver moj-prod.conf.in)
map $arg_id $moj_legacy_probid {
    default "";
    "~^(?<lorg>[^.]+)\.(?<lslug>.+)$" "$lorg%23$lslug";
}

# tempo de resposta no log — MESMO formato do moj-prod.conf.in (só um dos dois é instalado)
log_format moj '$remote_addr - $remote_user [$time_local] "$request" '
               '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
               'rt=$request_time urt=$upstream_response_time host=$host sni=$ssl_server_name a=$moj_authd';
# host=/sni=/a= (16/10/2026, antes de fechar o IP cru — moj-unknown-host.conf.in): por qual NOME o pedido chegou, o
# nome do TLS (vazio = sem SNI, o IP cru) e se trazia token (1/0 — nunca o token). Também no fim: as colunas de
# antes não se mexem.
map $http_authorization $moj_authd { "" 0; default 1; }

# anteparo de concorrência — MESMOS mapas do moj-prod.conf.in (o snippet os referencia)
map $moj_contest_host $moj_site_conn { "" "site"; default ""; }
limit_conn_zone $moj_site_conn zone=moj_site:1m;
limit_conn_status 429;
map $moj_contest_host $moj_shed_file { "" "/etc/nginx/moj-shed-treino"; default "/nonexistent"; }
map $moj_contest_host $moj_contest_conn { "" ""; default "contest"; }
limit_conn_zone $moj_contest_conn zone=moj_contest:1m;
# zona PRÓPRIA das rotas do porteiro (28/08, teste de carga): requisição de ~1 ms não pode
# disputar slot com a de 200 ms do bash — na zona única, o bash lento enchia os 56 e o 429
# cortava também o que custava nada. 256 slots ociosos na prática; o transbordo do porteiro
# já tem fallback próprio (backlog 16 → 502 → @moj_fcgiwrap).
limit_conn_zone $moj_contest_conn zone=moj_porteiro:1m;

# >>> AUTORIA (bloco IGUAL no moj-prod-http.conf.in; o smoke-problems-limit.sh compara os dois)
# 10/11/2026: o /api/v1/problems/ (editor, Painel de problemas, `moj`) ficava FORA de todo balde — de propósito, p/ o autor
# que termina um problema da prova não levar 429 do treino. Mas uma ferramenta em laço (07/11, LATAM: /problems/{tl,calib,
# status,validation} a 70/min, 1,47 s cada, ~3 workers) disputava o pool de 64 com o contest SEM teto nenhum. Duas zonas:
#   · moj_problems_key — 6 em voo POR SESSÃO (o token; sem token, o IP). O editor abre com no máximo ~5 em paralelo
#     (repos+source, share+coleções, as 4 do painel de validação, juízes); laço de script fica no balde DELE;
#   · moj_problems_ip — 8 em voo por IP: a chave da zona por sessão é o cabeçalho que o cliente manda, então o teto
#     por IP é o que reparte o total entre as origens (e conta também o Authorization > 255 bytes, que o nginx deixa
#     fora da zona da sessão). O corpo também tem prazo curto na location (client_body_timeout);
#   · moj_problems — 12 em voo no TOTAL: a autoria nunca passa de 12 dos 64, por mais autores que haja.
# O excedente leva 429 na hora (limit_conn_status, acima). A CLI repete o 429 do nginx (1, 2, 4, 8 s); a web mostra o
# erro e o poll da calibração tenta de novo no tick seguinte.
map $http_authorization $moj_problems_key { "" $binary_remote_addr; default $http_authorization; }
map $host $moj_problems_conn { default "problems"; }
limit_conn_zone $moj_problems_key zone=moj_problems_key:2m;
limit_conn_zone $binary_remote_addr zone=moj_problems_ip:2m;
limit_conn_zone $moj_problems_conn zone=moj_problems:1m;
# <<< AUTORIA

# >>> MÍDIA DE TIME (bloco IGUAL no moj-prod-http.conf.in; o smoke-team-media-nginx.sh o lê daqui e compara os dois)
# 05/11/2026: no placar de 500+ times o brasão era rebaixado a cada minuto (max-age=60, sem validador) e cada pedido era
# um bash no balde do contest, o MESMO do /submit. As peças moram no snippet (moj-app.conf.in, "MÍDIA DE TIME"):
#   · BRASÃO, FOTO, MÚSICA e o PADRÃO saem do disco pelo nginx. $moj_media_c é o contest SÓ quando o argumento passa na
#     lista de caracteres ($arg_* chega CRU: sem %, sem /, sem ponto ou hífen no começo, sem `..` — o valid_id) e o host
#     é o site principal ou o subdomínio DELE (o contest_mismatch do router.sh); $moj_team_dir junta o user com a mesma
#     lista. Fora disso os caminhos viram um arquivo que não existe e o pedido cai no bash, a autoridade (400/403/404);
#   · a foto segue a ordem do tp_file (photo.webp, depois o photo.png legado); com `thumb` não vazio (a regra do bash),
#     só a photo.thumb.webp — sem ela o bash a gera. A música é o music.mp3 (com Range/206, que o bash nunca teve);
#   · o PADRÃO (a rota /contest/placeholder e o time sem foto/música) segue o tp_placeholder/tm_placeholder: o do
#     contest, senão o de fábrica do checkout (cdmoj/server/etc/team-placeholder.*, o mesmo commit da imagem), com o
#     X-MOJ-Photo/X-MOJ-Music de sempre e 1 min; só com o contest EXISTENTE (o conf, a regra do require_contest);
#     `kind` com % ou `|` = o bash decide (o nginx não decodifica);
#   · com `v` na URL (logo_v do /contest/teams, mtime da galeria do telão) o asset do time é imutável; sem ele, o cache
#     de sempre do bash (brasão 10 min, miniatura 1 dia, foto e música 1 min — o telão externo busca sem `v`) + ETag;
#   · zona PRÓPRIA p/ o bash de mídia (o que caiu no bash): não disputa o balde do contest.
map "$arg_contest|$moj_contest_host" $moj_media_c {
    default "";
    "~^(?<mmc>(?![^|]*\.\.)[A-Za-z0-9][A-Za-z0-9._-]*)\|(?:\k<mmc>)?$" "$mmc";
}
map "$moj_media_c|$arg_user" $moj_team_dir {
    default "";
    "~^(?<mtc>[^|]+)\|(?<mtu>(?!.*\.\.)[A-Za-z0-9][A-Za-z0-9._-]*)$" "/$mtc/users/$mtu";
}
map $moj_team_dir $moj_logo_file { "" "/.sem-midia"; default "$moj_team_dir/logo.png"; }
map "$moj_team_dir|$arg_thumb" $moj_photo_file {
    default "/.sem-midia";
    "~^(?<mpf>/[^|]+)\|$" "$mpf/photo.webp";
    "~^(?<mpt>/[^|]+)\|." "$mpt/photo.thumb.webp";
}
map "$moj_team_dir|$arg_thumb" $moj_photo_alt {
    default "/.sem-midia";
    "~^(?<mpa>/[^|]+)\|$" "$mpa/photo.png";
}
map $moj_team_dir $moj_music_file { "" "/.sem-midia"; default "$moj_team_dir/music.mp3"; }
map $arg_v $moj_logo_cc { "" "public, max-age=600"; default "public, max-age=31536000, immutable"; }
map "$arg_v|$arg_thumb" $moj_photo_cc {
    default "public, max-age=60";
    "~^[^|]" "public, max-age=31536000, immutable";
    "~^\|."  "public, max-age=86400";
}
map $arg_v $moj_music_cc { "" "public, max-age=60"; default "public, max-age=31536000, immutable"; }
# O PADRÃO: qual (foto | miniatura | música | bash) e de qual contest. team-photo/team-music exigem o user (o bash dá
# 400 sem ele); a rota /contest/placeholder só o contest. O conf tem de existir (senão o bash dá o 404 de sempre).
map "$uri|$arg_kind|$arg_thumb" $moj_ph_kind {
    default "bash";
    "~^[^|]*\|[^|]*\|[^|]*\|"                    "bash";
    "~^/api/v1/contest/team-music\|"              "music";
    "~^/api/v1/contest/team-photo\|[^|]*\|$"      "photo";
    "~^/api/v1/contest/team-photo\|[^|]*\|."      "thumb";
    "~^/api/v1/contest/placeholder\|music\|"      "music";
    "~^/api/v1/contest/placeholder\|[^|%]*\|$"    "photo";
    "~^/api/v1/contest/placeholder\|[^|%]*\|."    "thumb";
}
map "$uri|$moj_team_dir|$moj_media_c" $moj_ph_conf {
    default "/.sem-midia";
    "~^/api/v1/contest/team-(?:photo|music)\|/[^|]+\|(?<mpc>[^|]+)$" "@WORKROOT@/contests/$mpc/conf";
    "~^/api/v1/contest/placeholder\|[^|]*\|(?<mpq>[^|]+)$"           "@WORKROOT@/contests/$mpq/conf";
}
# a foto do time EXISTE (só chega aqui sem a miniatura): o bash a gera dela — nunca o padrão no lugar da foto do time
map "$uri|$moj_team_dir" $moj_ph_has_webp {
    default "/.sem-midia";
    "~^/api/v1/contest/team-photo\|(?<mhw>/.+)$" "@WORKROOT@/contests$mhw/photo.webp";
}
map "$uri|$moj_team_dir" $moj_ph_has_png {
    default "/.sem-midia";
    "~^/api/v1/contest/team-photo\|(?<mhp>/.+)$" "@WORKROOT@/contests$mhp/photo.png";
}
map $moj_ph_kind $moj_ph1 {
    default "/.sem-midia";
    photo "/contests/$moj_media_c/placeholder.webp";
    thumb "/contests/$moj_media_c/placeholder.thumb.webp";
    music "/contests/$moj_media_c/placeholder.mp3";
}
map $moj_ph_kind $moj_ph2 {
    default "/.sem-midia";
    photo "/cdmoj/server/etc/team-placeholder.webp";
    thumb "/contests/$moj_media_c/placeholder.webp";
    music "/cdmoj/server/etc/team-placeholder.mp3";
}
map $moj_ph_kind $moj_ph3 { default "/.sem-midia"; thumb "/cdmoj/server/etc/team-placeholder.thumb.webp"; }
map $moj_ph_kind $moj_ph4 { default "/.sem-midia"; thumb "/cdmoj/server/etc/team-placeholder.webp"; }
map $moj_ph_kind $moj_ph_photo_hdr { default ""; photo "placeholder"; thumb "placeholder"; }
map $moj_ph_kind $moj_ph_music_hdr { default ""; music "placeholder"; }
map $host $moj_media_conn { default "media"; }
limit_conn_zone $moj_media_conn zone=moj_media:1m;
# <<< MÍDIA DE TIME
fastcgi_cache_path /run/moj-nginx-cache levels=1:2 keys_zone=moj_api:16m max_size=512m inactive=10s;
map $uri $moj_api_skip_uri { default 0; "~^/api/v1/contest/webcast" 1; }
map "$request_method$moj_api_skip_uri" $moj_api_skip { default 1; "GET0" 0; }

server {
    listen      80;
    listen      [::]:80;
    server_name @SERVER_NAMES@ @SERVER_NAMES_RE@;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    access_log /var/log/nginx/moj.access.log moj;
    error_log  /var/log/nginx/moj.error.log warn;

    include @SNIPPET@;
}
