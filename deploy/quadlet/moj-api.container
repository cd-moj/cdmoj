# moj-api.container — API MOJ (fcgiwrap + router.sh) como container rootless.
# TEMPLATE: `@WORKROOT@` é a raiz do workspace (o dir que contém cdmoj/ mojtools/ run/ …) e é
# substituída por `make install-units` ao instalar em ~/.config/containers/systemd/.
# NÃO copie este arquivo à mão (o systemd não expande `@WORKROOT@` — o container falharia
# apontando p/ um caminho inexistente).
# O nginx do HOST (fora da imagem) serve web/ e faz fastcgi_pass ao socket unix em
#   @WORKROOT@/run/fcgiwrap.sock  (= /data/run/fcgiwrap.sock dentro do container).
[Unit]
Description=MOJ API (fcgiwrap + router.sh)
After=network-online.target

[Container]
Image=localhost/moj-server:prod
# `podman auto-update` reinicia quando a imagem :prod local muda (build ou pull re-tagueado).
AutoUpdate=local
Exec=api
# INIT (tini como PID 1 — a chave do quadlet é RunInit, NÃO `Init`: com o nome errado o gerador
# rejeita o arquivo e a unit simplesmente NÃO EXISTE): sem init, o fcgiwrap vira o PID 1 do container
# e passa a ADOTAR os órfãos de todo handler (bash + jq + git); a contabilidade do `prefork` dele se
# perde e o processo-PAI entra em BUSY LOOP de wait4 — medido: 32.683 chamadas/s, 100% de um core,
# desde o boot, sem tráfego nenhum. O tini reapa os órfãos e o fcgiwrap só espera pelos filhos DELE.
RunInit=yes
# BACKLOG DA FILA DE CONEXÕES (rajada de F5 na contagem regressiva: 2000 times recarregando ao
# mesmo tempo). O socket é aberto pelo moj-entrypoint com FCGI_BACKLOG (10000) e entregue ao
# fcgiwrap no fd 0 — mas o `listen()` é CLAMPADO por net.core.somaxconn, que é por NAMESPACE DE
# REDE e vale p/ socket unix também. Sem esta linha o pedido de 10000 vira 4096 EM SILÊNCIO
# (o entrypoint avisa no log, mas a fila fica menor do que se pediu) e o excedente vira
# `connect() ... (11: Resource temporarily unavailable)` no nginx = 502 na cara do competidor.
# Medido na imagem de produção: somaxconn 4096 => 4097 na fila; 10000 => 10001.
# Mexeu aqui? Mexa no FCGI_BACKLOG do deploy/moj-entrypoint — os dois números andam JUNTOS.
Sysctl=net.core.somaxconn=10000
# Estado por volume, rótulo SELinux :z (SHARED — o nginx do host e o moj-judged mantêm acesso).
# NÃO usar :Z (privado) nem User=/UserNS=keep-id (quebraria o dono dos arquivos nos volumes).
Volume=@WORKROOT@/run:/data/run:z
Volume=@WORKROOT@/contests:/data/contests:z
Volume=@WORKROOT@/moj-problems:/data/moj-problems:z
Volume=@WORKROOT@/cdmoj/server/var/news:/data/news:z
Environment=INTAKE_MODE=queue

[Service]
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
