#!/bin/bash
# moj-entrypoint — despacha o papel do container (api | judged | bot | shell).
# Estado vem por volume em $RUNDIR/$CONTESTSDIR/... (ver quadlets). Idempotente.
set -euo pipefail

: "${MOJ_HOME:=/opt/moj/cdmoj}"
: "${RUNDIR:=/data/run}"
: "${CONTESTSDIR:=/data/contests}"
: "${MOJ_PROBLEMS_DIR:=/data/moj-problems}"
: "${NEWSDIR:=/data/news}"
: "${FCGI_SOCK:=$RUNDIR/fcgiwrap.sock}"
# Nº de workers do fcgiwrap = TETO de requisições de API em paralelo (cada uma é 1 bash+jq).
# Auto-dimensiona ao box: 2×núcleos, teto 64. Num contest de 1500 clientes polando, 8 (o valor
# fixo antigo) era o gargalo — sob concorrência a latência inflava (200 req concorrentes:
# mediana 347ms com 8 workers). Requisições são curtas (~12ms de CPU) e muitas I/O-bound
# (jq/git/find), então oversubscrição 2× é segura. Override explícito via env FCGI_WORKERS.
# O teto foi 32 até 26/08/2026; subiu p/ 64 junto do resize da VM p/ 48 núcleos (Maratona):
# o pool é compartilhado por TODAS as rotas, e um render de PDF de balão/impressão segura um
# worker por 3,5–9 s — na onda de ACs dos minutos 5–10 (régua subbr-2025: 110 balões/min) o
# teto de 32 deixava metade do pool preso em magick. Com 48 cores, 2×cores = 96 estouraria a
# memória de forks simultâneos sem ganho: 64 é o equilíbrio medido p/ o pior minuto (~20 de
# concorrência total projetada).
if [[ -z "${FCGI_WORKERS:-}" ]]; then
  _cores="$(nproc 2>/dev/null || echo 4)"; FCGI_WORKERS=$(( _cores * 2 ))
  (( FCGI_WORKERS > 64 )) && FCGI_WORKERS=64
  (( FCGI_WORKERS < 8 ))  && FCGI_WORKERS=8
fi
# O socket unix nasce com 0777&~umask. Com o default (022) sai 0755 = sem `w` p/ grupo/outros:
# um nginx que rode como OUTRO usuário (www-data, do nginx do sistema) leva EACCES no connect()
# e a API vira 502. 007 => 0770 (dono + GRUPO) e basta pôr o usuário do nginx no grupo do dono
# (`usermod -aG <dono> www-data`; o nginx faz initgroups()). Ver docs/DEPLOY.md.
#
# ATENÇÃO: este umask vale p/ o SOCKET — e, como o fcgiwrap o passa adiante, p/ tudo que os handlers
# gravam. NÃO é ele quem define o modo do PACOTE: todo arquivo de pacote é normalizado p/ 644/755
# por `_pkg_canon_modes` (lib/problems.sh), nos DOIS caminhos (push e upload). Foi preciso porque o
# `tl-checksum` inclui o MODO de scripts/*: com 660 pelo push e 644 pelo upload, o MESMO conteúdo
# gerava checksum diferente => recalibração espúria.
: "${FCGI_UMASK:=007}"

# dirs de runtime (nos volumes). sessions = 700 (tokens).
mkdir -p "$RUNDIR/sessions" "$RUNDIR/spool/submissions" "$RUNDIR/spool/submissions-done" \
         "$RUNDIR/results" "$RUNDIR/registry" "$RUNDIR/queue" "$RUNDIR/assigned" \
         "$RUNDIR/secrets" "$CONTESTSDIR" "$MOJ_PROBLEMS_DIR" "$NEWSDIR" 2>/dev/null || true
chmod 700 "$RUNDIR/sessions" "$RUNDIR/secrets" 2>/dev/null || true

role="${1:-api}"
case "$role" in
  api)
    # --- ORÇAMENTOS DE FRESCOR alargados p/ os times (decisão do Ribas, 28/08) ---------
    # Placar até ~30 s atrás do último veredicto (o daemon coalescido o mantém ~10 s típico)
    # e lote de boot com TTL 60 s: cada cache "velho" custa um DECLINE do porteiro p/ o bash
    # (100-300 ms sob carga) — alargar encolhe a classe bash, que é o teto atual. Edição de
    # admin propaga NA HORA mesmo assim: o frescor por ENTRADAS (-nt conf/rounds/overrides)
    # invalida independente do TTL. Handlers bash e porteiro honram os MESMOS envs.
    export SCORE_SERVE_FLOOR_S="${SCORE_SERVE_FLOOR_S:-30}"
    # basic = 5 min (decisão do Ribas): o corpo é 100% derivado dos 4 arquivos de entrada
    # (nada de relógio) e os casos pessoais — prorrogação, troca de coorte — mudam a CHAVE da
    # variante, propagando na hora. Nos momentos conturbados (abertura, F5 em massa) o basic
    # vira 100% porteiro. navbuttons/rounds FICAM em 60 s de propósito: têm conteúdo de
    # relógio (botão da cerimônia via contest_over_for_all; transição de rodada).
    export BASIC_CACHE_TTL="${BASIC_CACHE_TTL:-300}"
    export NAV_CACHE_TTL="${NAV_CACHE_TTL:-60}"
    export ROUNDS_CACHE_TTL="${ROUNDS_CACHE_TTL:-60}"
    # --- POOL DO MOLDE (workers bash persistentes) em background -----------------------
    # O shim (moj-molde-shim, compilado no build) abre o socket próprio e mantém N bash
    # pré-carregados; o nginx só o usa nas rotas com snippet em /etc/nginx/moj-molde-routes/
    # (error_page 502 = fallback automático p/ o fcgiwrap abaixo). Shim morto ⇒ o loop
    # respawna; loop morto ⇒ socket some ⇒ nginx cai no fallback sozinho. stderr em ARQUIVO
    # ($RUNDIR/molde.err) — pipe de stderr de vida longa já travou worker (ver CLAUDE.md).
    : "${MOLDE_WORKERS:=8}"
    : "${MOLDE_SOCK:=$RUNDIR/moj-molde.sock}"
    : "${MOLDE_TIMEOUT:=30}"     # deadline por requisição: rota quente responde em <1 s;
    : "${MOLDE_BACKLOG:=8}"      # 30 s preso = bash morto+respawn; backlog mínimo = transbordo
    if [[ -x /opt/moj/bin/moj-molde-shim && "${MOLDE_DISABLE:-0}" != 1 ]]; then
      rm -f "$MOLDE_SOCK" 2>/dev/null || true
      ( umask "$FCGI_UMASK"
        while :; do
          /opt/moj/bin/moj-molde-shim -s "$MOLDE_SOCK" -c "$MOLDE_WORKERS" \
            -t "$MOLDE_TIMEOUT" -b "$MOLDE_BACKLOG" \
            -w "$RUNDIR/molde" -m "$MOJ_HOME/server/api/v1/molde.sh" >> "$RUNDIR/molde.err" 2>&1
          echo "moj-entrypoint: molde-shim saiu (rc=$?) — respawn em 1s" >> "$RUNDIR/molde.err"
          sleep 1
        done ) &
    fi
    # --- PORTEIRO (caminho rápido Python das rotas quentes de leitura) ------------------
    # Leitor puro dos caches que o bash materializa; qualquer dúvida = fecha sem resposta =
    # 502 = fallback pro fcgiwrap (mesmo desenho de rota/fallback do molde). Ver
    # server/porteiro/moj-porteiro.py e o CLAUDE.md (Backend).
    : "${PORTEIRO_WORKERS:=4}"
    : "${PORTEIRO_SOCK:=$RUNDIR/moj-porteiro.sock}"
    if [[ -f "$MOJ_HOME/server/porteiro/moj-porteiro.py" && "${PORTEIRO_DISABLE:-0}" != 1 ]] \
       && command -v python3 >/dev/null 2>&1; then
      rm -f "$PORTEIRO_SOCK" 2>/dev/null || true
      ( umask "$FCGI_UMASK"
        while :; do
          python3 "$MOJ_HOME/server/porteiro/moj-porteiro.py" \
            -s "$PORTEIRO_SOCK" -c "$PORTEIRO_WORKERS" -b "${PORTEIRO_BACKLOG:=16}" \
            >> "$RUNDIR/porteiro.err" 2>&1
          echo "moj-entrypoint: porteiro saiu (rc=$?) — respawn em 1s" >> "$RUNDIR/porteiro.err"
          sleep 1
        done ) &
    fi
    # fcgiwrap roda o router.sh via nginx (que fica FORA da imagem e faz fastcgi_pass
    # p/ $FCGI_SOCK, montado por volume). Remove socket órfão antes de abrir.
    rm -f "$FCGI_SOCK" 2>/dev/null || true
    FCGI="$(command -v fcgiwrap || echo "$MOJ_HOME/server/bin/fcgiwrap")"
    umask "$FCGI_UMASK"          # socket 0770 (dono+grupo) — ver comentário acima
    # BACKLOG do socket: o fcgiwrap abre com 512 fixo (medido: a 545ª conexão pendente já dá
    # EAGAIN) e não tem opção p/ mudar. Com 2000 times apertando F5 na contagem regressiva, a
    # rajada de conexões passa fácil disso — e o nginx, sem conseguir connect(), devolve 502.
    # Medido de 5 máquinas externas em 20/08/2026: limpo até ~480 simultâneas, 26% de 502 em 640.
    # Solução: o socket é criado AQUI, com o backlog que quisermos, e entregue ao fcgiwrap no
    # fd 0 — que é a convenção do FastCGI (é assim que socket-activation funciona).
    #
    # ⚠ O `listen()` é CLAMPADO por net.core.somaxconn (no syscall genérico, vale p/ AF_UNIX
    # também) — pedir 10000 com somaxconn=4096 dá 4096 e NÃO avisa. Por isso o valor real vem em
    # par com o `Sysctl=net.core.somaxconn` do quadlet, e o aviso abaixo torna o clamp visível no
    # log em vez de silencioso. Medido na imagem de produção: somaxconn 4096 => 4097 conexões
    # enfileiradas antes do EAGAIN; somaxconn 10000 => 10001.
    : "${FCGI_BACKLOG:=10000}"
    _smc="$(cat /proc/sys/net/core/somaxconn 2>/dev/null || echo 0)"
    if [[ "$_smc" =~ ^[0-9]+$ ]] && (( _smc > 0 && _smc < FCGI_BACKLOG )); then
      echo "moj-entrypoint: AVISO — backlog pedido $FCGI_BACKLOG, mas net.core.somaxconn=$_smc" \
           "limita a fila a $_smc. Ajuste o Sysctl= do quadlet." >&2
    fi
    if command -v python3 >/dev/null 2>&1; then
      exec python3 - "$FCGI_SOCK" "$FCGI_BACKLOG" "$FCGI" "$FCGI_WORKERS" <<'PYEOF'
import os, socket, sys
sock_path, backlog, fcgi, workers = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.bind(sock_path)          # o umask do shell vale aqui: socket nasce 0770 como antes
s.listen(backlog)
os.dup2(s.fileno(), 0)     # fd 0 = socket em escuta: o que o fcgiwrap espera sem -s
if s.fileno() != 0: s.close()
os.execv(fcgi, [os.path.basename(fcgi), "-c", workers])
PYEOF
    fi
    # sem python3 na imagem: cai no modo antigo (backlog 512) em vez de não subir
    exec "$FCGI" -c "$FCGI_WORKERS" -s "unix:$FCGI_SOCK"
    ;;
  judged)
    exec /bin/bash "$MOJ_HOME/server/daemons/judged.sh"
    ;;
  bot)
    exec /bin/bash "$MOJ_HOME/mojinho-bot/mojinho-api.sh"
    ;;
  shell)
    exec /bin/bash
    ;;
  *)
    echo "moj-entrypoint: papel desconhecido: $role (use api|judged|bot|shell)" >&2
    exit 2
    ;;
esac
